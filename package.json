{
  "name": "gameroom",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5199 --strictPort",
    "dev:local": "bun scripts/local.ts",
    "check": "svelte-check --tsconfig tsconfig.json",
    "build": "bun scripts/build.ts",
    "preview": "vite preview --host 0.0.0.0 --port 4199 --strictPort",
    "test:unit": "bun test tests/*.test.ts",
    "test:rules": "bun scripts/emulators.ts rules",
    "test:e2e": "bun scripts/emulators.ts e2e",
    "test:e2e:update": "bun scripts/emulators.ts update",
    "dev:lab": "vite --host 0.0.0.0 --port 5299 --strictPort"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@fontsource/dm-sans": "^5.2.8",
    "@threlte/core": "8.5.16",
    "@threlte/extras": "9.23.0",
    "firebase": "12.16.0",
    "svelte": "5.55.5",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "@playwright/test": "1.61.1",
    "@sveltejs/vite-plugin-svelte": "7.1.0",
    "@types/bun": "^1.3.10",
    "@types/three": "0.185.4",
    "firebase-tools": "15.25.0",
    "sharp": "^0.35.5",
    "svelte-check": "4.7.2",
    "typescript": "5.9.3",
    "vite": "8.1.4"
  }
}
