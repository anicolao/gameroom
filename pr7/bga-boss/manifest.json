{
  "manifest_version": 3,
  "name": "BGA Boss — Gameroom test bridge",
  "version": "0.1.0",
  "description": "Open a BGA game, capture its table URL, and return it to an approved Gameroom page. Host only.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://boardgamearena.com/*",
    "https://en.boardgamearena.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://gameroom.boardgamescafe.org/*"
    ]
  },
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "BGA Boss: pending requests"
  },
  "key": ""
}
