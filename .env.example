# Local emulator defaults are supplied by bun run dev:local.
# For a deployed build, configure a Firebase project with anonymous auth and
# deploy firestore.rules. Never place service-account credentials here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_USE_FIREBASE_EMULATORS=false
VITE_CRIBBAGE_URL=https://anicolao.github.io/cribbage/

# Same public web configuration used by ttlauncher (LauncherUI project).
# Keep Applications in that project; the catalog client is read-only.
VITE_CATALOGUE_FIREBASE_API_KEY=
VITE_CATALOGUE_FIREBASE_AUTH_DOMAIN=
VITE_CATALOGUE_FIREBASE_PROJECT_ID=
VITE_CATALOGUE_FIREBASE_APP_ID=
VITE_CATALOGUE_USE_FIREBASE_EMULATORS=false
VITE_CATALOGUE_ASSET_ORIGIN=https://anicolao.github.io/ttlauncher/
PUBLIC_BASE_PATH=/
